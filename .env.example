# Local (docker-compose) — funciona sem editar nada
DATABASE_URL=postgresql://vasco:vasco@localhost:5432/vasco

# Neo4j local (docker-compose) — trocar pelas credenciais do Aura em producao
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=vasco12345

# Neo4j Aura (producao) — pegue no console do Aura
# NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=

# Intelligence (GraphRAG + agentes)
ANTHROPIC_API_KEY=

# Hashing de dados pessoais (CPF, e-mail, telefone) — trocar em producao
PII_HASH_SALT=dev-only-change-me
